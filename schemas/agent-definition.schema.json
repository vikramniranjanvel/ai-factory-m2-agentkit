{
  "$defs": {
    "Limits": {
      "additionalProperties": false,
      "description": "Runtime limits for one invocation. Omitted values use the AgentCore defaults.",
      "properties": {
        "max_iterations": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Maximum reasoning/tool-use loop iterations.",
          "examples": [
            10
          ],
          "title": "Max Iterations"
        },
        "timeout_seconds": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Wall-clock timeout for one invocation, in seconds.",
          "examples": [
            120
          ],
          "title": "Timeout Seconds"
        },
        "max_tokens": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Maximum total tokens generated across one invocation.",
          "examples": [
            8192
          ],
          "title": "Max Tokens"
        }
      },
      "title": "Limits",
      "type": "object"
    },
    "MemoryDisabled": {
      "additionalProperties": false,
      "description": "No memory: every conversation starts empty.",
      "properties": {
        "mode": {
          "const": "disabled",
          "description": "Memory off.",
          "title": "Mode",
          "type": "string"
        }
      },
      "required": [
        "mode"
      ],
      "title": "MemoryDisabled",
      "type": "object"
    },
    "MemoryManaged": {
      "additionalProperties": false,
      "description": "AgentCore-managed memory.",
      "properties": {
        "mode": {
          "const": "managed",
          "description": "Memory managed by AgentCore.",
          "title": "Mode",
          "type": "string"
        },
        "strategies": {
          "anyOf": [
            {
              "items": {
                "enum": [
                  "SEMANTIC",
                  "SUMMARIZATION",
                  "USER_PREFERENCE",
                  "EPISODIC"
                ],
                "type": "string"
              },
              "maxItems": 4,
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Long-term memory strategies to enable. Omit to use the AgentCore default.",
          "examples": [
            [
              "SEMANTIC",
              "SUMMARIZATION"
            ]
          ],
          "title": "Strategies"
        },
        "event_expiry_days": {
          "anyOf": [
            {
              "maximum": 365,
              "minimum": 3,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Days before memory events expire, 3 to 365.",
          "examples": [
            30
          ],
          "title": "Event Expiry Days"
        }
      },
      "required": [
        "mode"
      ],
      "title": "MemoryManaged",
      "type": "object"
    },
    "Model": {
      "additionalProperties": false,
      "description": "The foundation model the agent runs on.",
      "properties": {
        "provider": {
          "description": "Model provider. `bedrock` uses the environment's execution role; every other provider needs a `credential`.",
          "enum": [
            "bedrock",
            "open_ai",
            "gemini",
            "lite_llm"
          ],
          "examples": [
            "bedrock"
          ],
          "title": "Provider",
          "type": "string"
        },
        "model_id": {
          "description": "Provider-specific model identifier.",
          "examples": [
            "us.anthropic.claude-sonnet-4-5-20250929-v1:0",
            "gpt-4.1"
          ],
          "minLength": 1,
          "title": "Model Id",
          "type": "string"
        },
        "credential": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9_-]{1,64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Name of a credential registered in the environment (AgentKit resolves it to a provider ARN via SSM). Required for every provider except bedrock.",
          "examples": [
            "openai-prod"
          ],
          "title": "Credential"
        },
        "api_format": {
          "anyOf": [
            {
              "enum": [
                "converse_stream",
                "responses",
                "chat_completions"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Wire format for the provider. Only supported for bedrock (converse_stream, responses, chat_completions) and open_ai (responses, chat_completions).",
          "title": "Api Format"
        },
        "temperature": {
          "anyOf": [
            {
              "maximum": 2,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Sampling temperature, 0 to 2. Lower is more deterministic.",
          "examples": [
            0.2
          ],
          "title": "Temperature"
        },
        "top_p": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Nucleus sampling probability mass, 0 to 1.",
          "examples": [
            0.9
          ],
          "title": "Top P"
        },
        "top_k": {
          "anyOf": [
            {
              "maximum": 500,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Sample only from the k most likely tokens, 0 to 500. Gemini models only.",
          "examples": [
            250
          ],
          "title": "Top K"
        },
        "max_tokens": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Maximum tokens the model may generate per response.",
          "examples": [
            4096
          ],
          "title": "Max Tokens"
        }
      },
      "required": [
        "provider",
        "model_id"
      ],
      "title": "Model",
      "type": "object"
    },
    "Skill": {
      "additionalProperties": false,
      "description": "A skill kept in this project repository.",
      "properties": {
        "path": {
          "description": "Path to the skill, relative to agent.yaml. No `..` and no absolute paths.",
          "examples": [
            "skills/escalation"
          ],
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "title": "Skill",
      "type": "object"
    },
    "ToolRequest": {
      "additionalProperties": false,
      "description": "Tools the agent needs from one MCP server. A request: the platform registry decides whether it is granted.",
      "properties": {
        "server": {
          "description": "Id of an MCP server in the platform catalogue (`mcp/servers/<id>.json`).",
          "examples": [
            "kb-search"
          ],
          "pattern": "^[a-z][a-z0-9-]{0,39}$",
          "title": "Server",
          "type": "string"
        },
        "tools": {
          "description": "Tool names on that server, listed explicitly. Wildcards are not allowed.",
          "examples": [
            [
              "search",
              "get_doc"
            ]
          ],
          "items": {
            "pattern": "^[a-z][a-z0-9_-]{0,63}$",
            "type": "string"
          },
          "maxItems": 50,
          "minItems": 1,
          "title": "Tools",
          "type": "array"
        }
      },
      "required": [
        "server",
        "tools"
      ],
      "title": "ToolRequest",
      "type": "object"
    },
    "Truncation": {
      "additionalProperties": false,
      "description": "How conversation history is shortened when it grows too long.",
      "properties": {
        "strategy": {
          "description": "`none` keeps everything; `sliding_window` keeps the last N messages; `summarization` summarizes older messages.",
          "enum": [
            "none",
            "sliding_window",
            "summarization"
          ],
          "title": "Strategy",
          "type": "string"
        },
        "messages_count": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Messages to keep. Only for `sliding_window`.",
          "examples": [
            20
          ],
          "title": "Messages Count"
        },
        "summary_ratio": {
          "anyOf": [
            {
              "exclusiveMaximum": 1,
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Fraction of history to summarize, between 0 and 1. Only for `summarization`.",
          "examples": [
            0.3
          ],
          "title": "Summary Ratio"
        },
        "preserve_recent_messages": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Most recent messages kept verbatim. Only for `summarization`.",
          "examples": [
            5
          ],
          "title": "Preserve Recent Messages"
        }
      },
      "required": [
        "strategy"
      ],
      "title": "Truncation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "An agent as the project author describes it (`agent.yaml`).",
  "properties": {
    "schema_version": {
      "const": 1,
      "description": "Version of this file format. Always 1 for now.",
      "title": "Schema Version",
      "type": "integer"
    },
    "project": {
      "description": "Name of this project in the platform registry (`registry/<project>.json`): lowercase letters, digits and hyphens, up to 40 characters. AgentKit deploys with the role `agentkit-<env>-<project>-deploy` and reads `/agentkit/<env>/projects/<project>/`, which exist only for the environments the project is registered for.",
      "examples": [
        "support-triage"
      ],
      "pattern": "^[a-z][a-z0-9-]{0,39}$",
      "title": "Project",
      "type": "string"
    },
    "name": {
      "description": "Agent name: a letter, then letters and digits, up to 32 characters (no underscores or hyphens). The deployed harness is named `<environment prefix>_<name>`.",
      "examples": [
        "supportTriage"
      ],
      "pattern": "^[A-Za-z][A-Za-z0-9]{0,31}$",
      "title": "Name",
      "type": "string"
    },
    "description": {
      "anyOf": [
        {
          "maxLength": 500,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "What the agent does, up to 500 characters.",
      "examples": [
        "Triages support tickets."
      ],
      "title": "Description"
    },
    "model": {
      "$ref": "#/$defs/Model",
      "description": "The foundation model and its sampling settings."
    },
    "prompt": {
      "default": "prompts/system.md",
      "description": "Path to the system prompt, relative to agent.yaml.",
      "examples": [
        "prompts/system.md"
      ],
      "title": "Prompt",
      "type": "string"
    },
    "skills": {
      "default": [],
      "description": "Skills available to the agent.",
      "items": {
        "$ref": "#/$defs/Skill"
      },
      "title": "Skills",
      "type": "array"
    },
    "tools": {
      "default": [],
      "description": "MCP tools the agent needs, per server. This is a request: the deploy fails if the platform registry does not grant every listed tool for the environment.",
      "items": {
        "$ref": "#/$defs/ToolRequest"
      },
      "title": "Tools",
      "type": "array"
    },
    "memory": {
      "default": {
        "mode": "disabled"
      },
      "description": "Conversation memory. Off by default.",
      "discriminator": {
        "mapping": {
          "disabled": "#/$defs/MemoryDisabled",
          "managed": "#/$defs/MemoryManaged"
        },
        "propertyName": "mode"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/MemoryDisabled"
        },
        {
          "$ref": "#/$defs/MemoryManaged"
        }
      ],
      "title": "Memory"
    },
    "limits": {
      "$ref": "#/$defs/Limits",
      "default": {
        "max_iterations": null,
        "timeout_seconds": null,
        "max_tokens": null
      },
      "description": "Runtime limits for one invocation."
    },
    "truncation": {
      "anyOf": [
        {
          "$ref": "#/$defs/Truncation"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "How to shorten long conversation history. Omit to use the AgentCore default."
    },
    "tags": {
      "additionalProperties": {
        "maxLength": 256,
        "type": "string"
      },
      "default": {},
      "description": "Resource tags (at most 40). Keys starting with `agentcore:`, `agentkit:` or `aws:` are reserved.",
      "examples": [
        {
          "team": "support"
        }
      ],
      "title": "Tags",
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "project",
    "name",
    "model"
  ],
  "title": "AgentDefinition",
  "type": "object"
}
